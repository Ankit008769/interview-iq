PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/interviewiq
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Optional: without a key InterviewIQ runs in clearly labeled PRACTICE mode.
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
# Leave AI_PROVIDER unset for legacy auto-selection (OpenAI when a key exists).
# Set explicitly to practice, openai, or compatible when deploying.
# AI_PROVIDER=practice
# Separate model slots; AI_MODEL remains the OpenAI fallback.
# INTERVIEWER_MODEL=gpt-4o-mini
# JUDGE_MODEL=gpt-4o-mini
# Compatible provider: HTTPS endpoint + token, both model slots required.
# HTTP without a token is allowed only for a loopback development endpoint.
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_GATEWAY_TOKEN=
# Shared MongoDB quotas; daily windows reset at 00:00 UTC.
INTERVIEW_WRITES_PER_15_MIN=40
INTERVIEWS_PER_DAY=20
AI_CALLS_PER_DAY=100

# Actual operator name shown for a compatible AI gateway (endpoint is also shown).
LLM_PROVIDER_NAME=

# Required for account deletion in production. ADC uses the Cloud Run identity.
# Dedicated private bucket; runtime needs bucket-scoped Storage Object Creator only.
DELETION_LEDGER_BUCKET=
