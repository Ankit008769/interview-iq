PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/interviewiq
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Optional: without a key InterviewIQ runs in clearly labeled PRACTICE mode.
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
# Shared MongoDB quotas; daily windows reset at 00:00 UTC.
INTERVIEW_WRITES_PER_15_MIN=40
INTERVIEWS_PER_DAY=20
AI_CALLS_PER_DAY=100
