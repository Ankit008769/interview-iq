{
  "name": "interviewiq-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "calibration": "tsx src/scripts/calibration.ts",
    "local-check": "tsx src/scripts/localCheck.ts",
    "comparison": "tsx src/scripts/providerComparison.ts",
    "coding:verify": "tsx src/scripts/codingVerify.ts",
    "project-check": "tsx src/scripts/projectCheck.ts",
    "design-check": "tsx src/scripts/designCheck.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.4.0",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.21.0",
    "mongoose": "^8.9.5",
    "openai": "^6.0.0",
    "ts-fsrs": "^5.4.2",
    "yauzl": "^3.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.10.5",
    "@types/supertest": "^7.2.1",
    "@types/yauzl": "^3.4.0",
    "fflate": "^0.8.2",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "tsx": "^4.20.3",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  }
}
